{
	"name": "dsh-qq-notice",
	"version": "1.0.1",
	"description": "DSH基于QQ机器人的通知插件",
	"type": "module",
	"main": "./lib/index.js",
	"files": [
		"cordis.patch.yml",
		"lib",
		"README.md"
	],
	"exports": {
		".": {
			"import": "./lib/index.js"
		},
		"./client": {
			"default": "./lib/client.js"
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"dsh": ">=0.2.2-rc.5 <0.3.0-0",
		"node": ">=24.9.0"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web"
		}
	},
	"scripts": {
		"test": "node --test \"test/*.test.mjs\"",
		"prepublishOnly": "node --test \"test/*.test.mjs\""
	},
	"dependencies": {
		"@tencent-connect/qqbot-nodejs": "^1.0.5"
	},
	"peerDependencies": {
		"@deepseek-ai/schemastery": "^3.19.0 || >=3.20.0-alpha.1 <3.21.0-0"
	},
	"keywords": [
		"dsh",
		"deepseek-harness",
		"plugin",
		"qq",
		"qqbot",
		"notification",
		"notify"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/1095314734/dsh-qq-notice.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
